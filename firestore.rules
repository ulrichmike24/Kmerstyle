rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Products catalog: readable by anyone, editable by management
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isValidId(productId);
    }

    // Real Customer Orders
    match /orders/{orderId} {
      allow read: if true;
      allow create: if isValidId(orderId) && incoming().total > 0;
      allow update: if isValidId(orderId);
      allow delete: if isValidId(orderId);
    }

    // Couriers / Delivery Agents
    match /couriers/{courierId} {
      allow read: if true;
      allow create, update, delete: if isValidId(courierId);
    }

    // Accounting Operational Expenses
    match /expenses/{expenseId} {
      allow read, create, update, delete: if isValidId(expenseId);
    }

    // Traceable Audit Logs
    match /audit_logs/{logId} {
      allow read, create: if isValidId(logId);
    }

    // System Settings (Admin credentials & merchant codes)
    match /settings/{settingId} {
      allow read, write: if isValidId(settingId);
    }

    // Test connection check
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
